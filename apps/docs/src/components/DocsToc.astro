---
/**
 * 桌面端右侧的「本页内容」（覆盖 Starlight 的 TableOfContents，astro.config.mjs 的 components）。
 * 照参考站（Fumadocs 那套）的行为做的，2026-11-26 在 ego 里逐项核对过它的实际表现：
 *
 * - 轨道：一条发丝线串起各条，进入小节时斜着往里折一下；**屏幕里露着的那几节**对应的那段线变成品牌色
 * - 分组：带小节的章节右边一个箭头，默认收起；滚到哪一章那一章自动展开，手动展开 / 收起的以手动为准（只在本次浏览有效）
 * - 右上角的按钮收起整个目录（正文在让出来的地方重新居中），记在 localStorage，刷新后还是收起的
 *
 * 轨道是脚本按每一条的实际位置画的 SVG（条目会折行、分组会开合）；脚本没跑时只是没有轨道和箭头，
 * 目录全展开、照常能点。手机上的目录条是 Starlight 的 MobileTableOfContents，不走这里。
 */
const { toc } = Astro.locals.starlightRoute
type TocItem = NonNullable<typeof toc>['items'][number]
// 目录只画两层：章节和它下面的小节。再深的标题（把 tableOfContents.maxHeadingLevel 调到 4 以上时才有）
// 拍平进所在章节的小节列表，不能直接丢 —— 只渲染 children 那一层的话，第三层会静默消失
const flat = (items: TocItem[]): TocItem[] => items.flatMap((i) => [i, ...flat(i.children)])
const t = (zh: string, en: string) => (Astro.locals.starlightRoute.locale === 'en' ? en : zh)
---

{
  toc && (
    <fra-toc>
      <script is:inline>
        // 在目录和正文画出来之前就把「收起」状态挂上，避免先展开再收起的闪一下
        try { if (localStorage.getItem('fra-docs:toc-collapsed') === '1') document.documentElement.setAttribute('data-toc-collapsed', '') } catch {}
      </script>
      <button
        type="button"
        class="toc-toggle"
        data-label-open={t('收起本页目录', 'Hide contents')}
        data-label-closed={t('展开本页目录', 'Show contents')}
        aria-label={t('收起本页目录', 'Hide contents')}
        title={t('收起本页目录', 'Hide contents')}
        aria-expanded="true"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M15 3v18" /><path class="toc-toggle-arrow" d="m8 9 3 3-3 3" /></svg>
      </button>
      <nav aria-labelledby="starlight__on-this-page" class="toc-nav">
        <h2 id="starlight__on-this-page" class="toc-title">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 5H3M15 12H3M17 19H3" /></svg>
          {Astro.locals.t('tableOfContents.onThisPage')}
        </h2>
        <div class="toc-body">
          <svg class="toc-track" aria-hidden="true"><path class="toc-track-base" /></svg>
          <svg class="toc-track toc-track-lit" aria-hidden="true"><path class="toc-track-active" /></svg>
          <ul class="toc-list">
            {toc.items.map((item) => (
              <li class="toc-group" data-open>
                <div class="toc-row" data-level="0">
                  <a href={`#${item.slug}`}>{item.text}</a>
                  {item.children.length > 0 && (
                    <button type="button" class="toc-fold" aria-expanded="true" aria-label={t('收起小节', 'Collapse')} data-label-open={t('收起小节', 'Collapse')} data-label-closed={t('展开小节', 'Expand')}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                    </button>
                  )}
                </div>
                {item.children.length > 0 && (
                  <ul class="toc-sub">
                    {flat(item.children).map((child) => (
                      <li><div class="toc-row" data-level="1"><a href={`#${child.slug}`}>{child.text}</a></div></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </fra-toc>
  )
}

<script>
  /** 一级缩进多少、轨道左边留多宽、折过去用多高（px），和样式里的 --indent / --rail 对上 */
  const INDENT = 12
  const RAIL_X = 6
  const JOG = 8
  const KEY = 'fra-docs:toc-collapsed'

  class FraToc extends HTMLElement {
    links: HTMLAnchorElement[] = []
    headings: (HTMLElement | null)[] = []
    groups: HTMLElement[] = []
    /** 手动开合过的分组：true 开 / false 关；没在表里的跟着「是不是当前章」走 */
    manual = new Map<HTMLElement, boolean>()
    frame = 0

    connectedCallback() {
      this.links = [...this.querySelectorAll<HTMLAnchorElement>('.toc-list a')]
      this.headings = this.links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      this.groups = [...this.querySelectorAll<HTMLElement>('.toc-group')]

      for (const group of this.groups) {
        group.querySelector('.toc-fold')?.addEventListener('click', () => {
          this.manual.set(group, !group.hasAttribute('data-open'))
          this.update()
        })
      }
      const toggle = this.querySelector<HTMLButtonElement>('.toc-toggle')
      toggle?.addEventListener('click', () => {
        const collapsed = !document.documentElement.hasAttribute('data-toc-collapsed')
        document.documentElement.toggleAttribute('data-toc-collapsed', collapsed)
        try { localStorage.setItem(KEY, collapsed ? '1' : '0') } catch {}
        this.syncToggle()
        this.update()
      })
      this.syncToggle()

      const schedule = () => {
        cancelAnimationFrame(this.frame)
        this.frame = requestAnimationFrame(() => this.update())
      }
      this.update()
      addEventListener('scroll', schedule, { passive: true })
      addEventListener('resize', schedule)
      document.fonts?.ready.then(schedule)
    }

    syncToggle() {
      const toggle = this.querySelector<HTMLButtonElement>('.toc-toggle')
      if (!toggle) return
      const open = !document.documentElement.hasAttribute('data-toc-collapsed')
      const label = open ? toggle.dataset.labelOpen : toggle.dataset.labelClosed
      toggle.setAttribute('aria-expanded', String(open))
      if (label) { toggle.setAttribute('aria-label', label); toggle.title = label }
    }

    /** 屏幕里露着的那几节：一节的范围是「本节标题 → 目录里下一条的标题」 */
    activeRange(): [number, number] {
      const navBottom = document.querySelector('header')?.getBoundingClientRect().bottom ?? 0
      const tops = this.headings.map((h) => h?.getBoundingClientRect().top ?? Infinity)
      const pageEnd = document.querySelector('.sl-markdown-content')?.getBoundingClientRect().bottom ?? innerHeight
      let first = -1
      let last = -1
      tops.forEach((top, i) => {
        const end = i + 1 < tops.length ? tops[i + 1] : pageEnd
        if (top < innerHeight && end > navBottom + 1) {
          if (first < 0) first = i
          last = i
        }
      })
      return [first, last]
    }

    update() {
      if (document.documentElement.hasAttribute('data-toc-collapsed')) return
      const [first, last] = this.activeRange()
      const active = new Set<HTMLAnchorElement>()
      if (first >= 0) for (let i = first; i <= last; i++) active.add(this.links[i])

      // 分组开合：手动的优先；否则「露着的节在这一章里」就展开。小节亮着时章标题也一起亮
      for (const group of this.groups) {
        const head = group.querySelector<HTMLAnchorElement>(':scope > .toc-row a')!
        const subs = [...group.querySelectorAll<HTMLAnchorElement>('.toc-sub a')]
        const current = active.has(head) || subs.some((a) => active.has(a))
        if (subs.some((a) => active.has(a))) active.add(head)
        const open = this.manual.get(group) ?? current
        group.toggleAttribute('data-open', open || !subs.length)
        const fold = group.querySelector<HTMLButtonElement>('.toc-fold')
        if (fold) {
          fold.setAttribute('aria-expanded', String(open))
          const label = open ? fold.dataset.labelOpen : fold.dataset.labelClosed
          if (label) fold.setAttribute('aria-label', label)
        }
      }
      // 收起的分组里亮着的小节不可见，把高亮落到章标题上（上面已经加进 active 了）
      this.links.forEach((a) => a.toggleAttribute('data-active', active.has(a)))
      this.drawTrack(active)
      this.keepInView()
    }

    /** 按看得见的每一行画轨道：同一层竖线，层级变了斜着折过去。
     *  亮着的那段是同一条路径再描一遍品牌色，用 clip-path 只露出「第一条亮着的 → 最后一条亮着的」之间（参考站也是这么做的），
     *  所以中间夹着没露出来的小节时线也是连续的一段 */
    drawTrack(active: Set<HTMLAnchorElement>) {
      const list = this.querySelector<HTMLElement>('.toc-list')
      const svgs = [...this.querySelectorAll<SVGSVGElement>('.toc-track')]
      if (!list || svgs.length < 2) return
      const base = list.getBoundingClientRect().top
      const rows = [...list.querySelectorAll<HTMLElement>('.toc-row')].filter((r) => r.offsetParent !== null)
      const path = (sel: HTMLElement[]) => {
        let d = ''
        let prevX = -1
        let prevBottom = -1
        for (const row of sel) {
          const r = row.getBoundingClientRect()
          const x = RAIL_X + Number(row.dataset.level) * INDENT
          const top = r.top - base
          const bottom = r.bottom - base
          if (prevX < 0 || Math.abs(top - prevBottom) > 1) d += `M${x} ${top}`
          else if (x !== prevX) d += ` L${x} ${top + JOG}`
          d += ` L${x} ${bottom}`
          prevX = x
          prevBottom = bottom
        }
        return d
      }
      const d = path(rows)
      const height = list.offsetHeight
      for (const svg of svgs) {
        svg.style.height = `${height}px`
        svg.querySelector('path')?.setAttribute('d', d)
      }
      const lit = rows.filter((row) => active.has(row.querySelector('a')!))
      const litSvg = svgs[1]
      if (!lit.length) { litSvg.style.clipPath = `inset(0 0 ${height}px 0)`; return }
      const top = lit[0].getBoundingClientRect().top - base
      const bottom = lit[lit.length - 1].getBoundingClientRect().bottom - base
      litSvg.style.clipPath = `inset(${top}px 0 ${Math.max(0, height - bottom)}px 0)`
    }

    /** 长目录：让第一条亮着的留在目录面板里看得见。只动面板自己的 scrollTop ——
     *  scrollIntoView 会连整页一起拽着滚（ProductTour 踩过，见 AGENTS.md） */
    keepInView() {
      const first = this.querySelector<HTMLElement>('a[data-active]')
      const panel = this.closest<HTMLElement>('.right-sidebar')
      if (!first || !panel || panel.scrollHeight <= panel.clientHeight) return
      const navBottom = document.querySelector('header')?.getBoundingClientRect().bottom ?? 0
      const p = panel.getBoundingClientRect()
      const r = first.getBoundingClientRect()
      if (r.top < p.top + navBottom) panel.scrollTop -= p.top + navBottom - r.top + 16
      else if (r.bottom > p.bottom) panel.scrollTop += r.bottom - p.bottom + 16
    }
  }
  customElements.define('fra-toc', FraToc)
</script>

<style>
  fra-toc { position: relative; display: block }

  .toc-toggle {
    position: absolute; top: -0.2rem; right: 0; display: grid; place-items: center;
    width: 1.75rem; height: 1.75rem; padding: 0; border: 0; border-radius: 0.4rem; cursor: pointer;
    color: var(--sl-color-gray-3); background: transparent;
  }
  .toc-toggle:hover { color: var(--sl-color-white); background: var(--sl-color-gray-6) }
  .toc-toggle:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 1px }
  .toc-toggle svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round }
  :global(:root[data-toc-collapsed]) .toc-toggle-arrow { transform: rotate(180deg); transform-origin: 9.5px 12px }
  :global(:root[data-toc-collapsed]) .toc-nav { display: none }

  .toc-title {
    display: flex; align-items: center; gap: 0.4rem; margin: 0 2rem 0.6rem 0;
    font-size: var(--fs-sm); font-weight: var(--fw-medium); line-height: var(--lh-ui); color: var(--sl-color-gray-3);
  }
  .toc-title svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round }

  .toc-body { position: relative }
  .toc-track { position: absolute; inset: 0 auto auto 0; width: 2.5rem; overflow: visible; pointer-events: none }
  .toc-track path { fill: none; stroke-linejoin: round; stroke-linecap: round }
  .toc-track-base { stroke: var(--sl-color-gray-5); stroke-width: 1 }
  .toc-track-active { stroke: var(--sl-color-accent); stroke-width: 1.5 }
  .toc-track-lit { clip-path: inset(0 0 100% 0); transition: clip-path 0.25s ease }

  .toc-list, .toc-sub { list-style: none; margin: 0; padding: 0 }
  .toc-list { --indent: 12px; --rail: 6px }
  .toc-group:not([data-open]) > .toc-sub { display: none }
  .toc-row { display: flex; align-items: flex-start; gap: 0.25rem }
  .toc-row a {
    flex: 1; min-width: 0; display: block;
    padding: 0.3rem 0.25rem 0.3rem calc(var(--rail) + 0.85rem + var(--level, 0) * var(--indent));
    font-size: var(--fs-sm); line-height: var(--lh-ui); color: var(--sl-color-gray-3);
    text-decoration: none; overflow-wrap: anywhere; transition: color 0.2s ease;
  }
  .toc-row[data-level='1'] a { --level: 1 }
  .toc-row a:hover { color: var(--sl-color-white) }
  .toc-row a[data-active] { color: var(--sl-color-accent-high) }
  .toc-row a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: -2px; border-radius: 0.25rem }

  .toc-fold {
    flex-shrink: 0; display: grid; place-items: center; width: 1.25rem; height: 1.25rem; margin-top: 0.3rem;
    padding: 0; border: 0; border-radius: 0.3rem; cursor: pointer; color: var(--sl-color-gray-3); background: transparent;
    opacity: 0.6; transition: opacity 0.15s ease;
  }
  .toc-row:hover .toc-fold, .toc-fold:focus-visible { opacity: 1 }
  .toc-fold:hover { background: var(--sl-color-gray-6); color: var(--sl-color-white) }
  .toc-fold svg { width: 0.85rem; height: 0.85rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s ease }
  .toc-fold[aria-expanded='true'] svg { transform: rotate(90deg) }

  @media (prefers-reduced-motion: reduce) { .toc-row a, .toc-fold svg, .toc-track-lit { transition: none } }
</style>
